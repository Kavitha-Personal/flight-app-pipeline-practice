# Copy this file to ".env" on your laptop:   copy .env.example .env     (Windows)
# The real ".env" is ignored by Git and never pushed. This ".env.example" IS committed.
#
# PRACTICE ONLY: these are the demo accounts of the practice app, so the real values are shown.
# In a real project this file contains placeholders, and the real values are shared securely
# (password manager, team vault) and stored in GitHub Secrets for the pipeline.

TEST_USERNAME=qa.customer@example.com
TEST_PASSWORD=Passw0rd!
OTHER_USERNAME=qa.other@example.com
OTHER_PASSWORD=Passw0rd!2

# Leave BASE_URL commented out: the tests start their own copy of the app on http://localhost:3000.
# Set it only to point the same tests at a deployed environment (dev / test / staging).
# BASE_URL=https://test.example.com
